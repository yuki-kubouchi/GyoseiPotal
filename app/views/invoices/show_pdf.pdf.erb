<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>請求書</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Noto Sans JP', 'Hiragino Sans', Arial, sans-serif;
      font-size: 10pt;
      color: #333;
      line-height: 1.4;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px 30px;
    }
    .header {
      text-align: center;
      margin-bottom: 15px;
    }
    .title {
      font-size: 20pt;
      font-weight: bold;
      margin-bottom: 10px;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
      font-size: 9pt;
    }
    .info-label {
      font-weight: bold;
      width: 100px;
    }
    .info-value {
      flex: 1;
    }
    .section {
      margin-bottom: 12px;
    }
    .section-title {
      font-size: 11pt;
      font-weight: bold;
      border-bottom: 1px solid #333;
      padding-bottom: 2px;
      margin-bottom: 8px;
    }
    .customer-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      gap: 30px;
    }
    .customer-box {
      flex: 1;
    }
    .issuer-box {
      flex: 1;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
      font-size: 9pt;
    }
    .table th {
      background-color: #f0f0f0;
      border: 1px solid #ccc;
      padding: 4px;
      text-align: left;
      font-weight: bold;
    }
    .table td {
      border: 1px solid #ccc;
      padding: 4px;
      text-align: left;
    }
    .table td.number {
      text-align: right;
    }
    .totals {
      display: flex;
      justify-content: flex-end;
      margin-top: 10px;
    }
    .totals-box {
      width: 250px;
      font-size: 9pt;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      padding: 2px 0;
      border-bottom: 1px solid #ccc;
    }
    .total-row.grand-total {
      border-bottom: 2px solid #333;
      font-size: 11pt;
      font-weight: bold;
      padding: 4px 0;
      margin-top: 4px;
    }
    .notes {
      margin-top: 8px;
      padding: 8px;
      background-color: #f9f9f9;
      border-left: 2px solid #333;
      font-size: 8pt;
    }
    .footer {
      margin-top: 15px;
      padding-top: 10px;
      border-top: 1px solid #ccc;
      font-size: 8pt;
      text-align: right;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="title">請求書</div>
    </div>

    <!-- Basic Info -->
    <div class="section">
      <div class="info-row">
        <span class="info-label">請求書番号</span>
        <span class="info-value"><%= invoice.invoice_number %></span>
      </div>
      <div class="info-row">
        <span class="info-label">発行日</span>
        <span class="info-value"><%= invoice.issue_date.strftime('%Y年%m月%d日') %></span>
      </div>
    </div>

    <!-- Customer Info -->
    <div class="section">
      <div class="section-title">請求先</div>
      <div class="customer-info">
        <div class="customer-box">
          <% if invoice.customer&.company_name.present? %>
            <div class="info-row">
              <span class="info-value"><strong><%= invoice.customer.company_name %> 御中</strong></span>
            </div>
          <% else %>
            <div class="info-row">
              <span class="info-value"><strong><%= invoice.customer&.name %> 様</strong></span>
            </div>
          <% end %>
          <% if invoice.application.present? %>
          <div class="info-row">
            <span class="info-label">案件</span>
            <span class="info-value"><%= invoice.application.title %></span>
          </div>
          <% end %>
        </div>
        <div class="issuer-box">
          <strong style="font-size: 9pt;">発行者情報</strong>
          <div class="info-row" style="margin-bottom: 2px;">
            <span class="info-label" style="width: 60px;">事務所</span>
            <span class="info-value">行政ポータル事務所</span>
          </div>
          <div class="info-row" style="margin-bottom: 2px;">
            <span class="info-label" style="width: 60px;">電話</span>
            <span class="info-value">03-1234-5678</span>
          </div>
          <div class="info-row">
            <span class="info-label" style="width: 60px;">メール</span>
            <span class="info-value">info@gyoseipotal.jp</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoice Items -->
    <div class="section">
      <div class="section-title">明細</div>
      <table class="table">
        <thead>
          <tr>
            <th>品名</th>
            <th style="width: 120px;" class="number">単価 (円)</th>
          </tr>
        </thead>
        <tbody>
          <% invoice.invoice_items.each do |item| %>
          <tr>
            <td><%= item.description %></td>
            <td class="number"><%= number_with_delimiter(item.unit_price.to_i) %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Totals -->
    <div class="totals">
      <div class="totals-box">
        <div class="total-row">
          <span>小計 (税抜き)</span>
          <span><%= number_with_delimiter(invoice.subtotal.to_i) %> 円</span>
        </div>
        <div class="total-row">
          <span>消費税 (<%= invoice.tax_rate %>%)</span>
          <span><%= number_with_delimiter(invoice.tax_amount.to_i) %> 円</span>
        </div>
        <div class="total-row grand-total">
          <span>合計</span>
          <span><%= number_with_delimiter(invoice.total.to_i) %> 円</span>
        </div>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="section">
      <div class="section-title">振込先</div>
      <div class="info-row">
        <span class="info-label">銀行名</span>
        <span class="info-value">〇〇銀行</span>
      </div>
      <div class="info-row">
        <span class="info-label">支店名</span>
        <span class="info-value">〇〇支店</span>
      </div>
      <div class="info-row">
        <span class="info-label">口座種別</span>
        <span class="info-value">普通預金</span>
      </div>
      <div class="info-row">
        <span class="info-label">口座番号</span>
        <span class="info-value">1234567</span>
      </div>
      <div class="info-row">
        <span class="info-label">口座名義</span>
        <span class="info-value">行政ポータル事務所</span>
      </div>
      <div class="info-row">
        <span class="info-label">支払期日</span>
        <span class="info-value"><strong><%= invoice.due_date.strftime('%Y年%m月%d日') %></strong></span>
      </div>
    </div>

    <!-- Notes -->
    <% if invoice.notes.present? %>
    <div class="section">
      <div class="section-title">備考</div>
      <div class="notes">
        <%= simple_format(invoice.notes) %>
      </div>
    </div>
    <% end %>

    <div class="footer">
      発行日: <%= invoice.issue_date.strftime('%Y年%m月%d日') %>
    </div>
  </div>
</body>
</html>

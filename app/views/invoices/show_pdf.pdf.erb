<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>請求書</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: "Yu Gothic", "Hiragino Kaku Gothic ProN", "Meiryo", sans-serif;
      font-size: 12pt;
      color: #333;
      line-height: 1.2;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 8px 15px;
    }
    .main-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .main-table td {
      padding: 0;
      vertical-align: top;
    }
    .left-col {
      width: 48%;
    }
    .spacer-col {
      width: 4%;
    }
    .right-col {
      width: 48%;
    }
    .header {
      text-align: center;
      margin-bottom: 4px;
    }
    .title {
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 2px;
    }
    .info-row {
      display: flex;
      margin-bottom: 3px;
      font-size: 13px;
    }
    .info-label {
      font-weight: bold;
      width: 60px;
      flex-shrink: 0;
    }
    .info-value {
      flex: 1;
    }
    .section-title {
      font-size: 15px;
      font-weight: bold;
      border-bottom: 1px solid #333;
      padding-bottom: 2px;
      margin-bottom: 3px;
    }
    .box {
      padding: 7px;
      border: 1px solid #e0e0e0;
      background-color: #f9f9f9;
      border-radius: 4px;
    }
    .box-title {
      font-size: 15px;
      font-weight: bold;
      border-bottom: 1px solid #333;
      padding-bottom: 2px;
      margin-bottom: 4px;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12pt;
    }
    .table th {
      background-color: #f9f9f9;
      border: 1px solid #e0e0e0;
      padding: 5px 6px;
      text-align: left;
      font-weight: bold;
      font-size: 13px;
    }
    .table td {
      border: 1px solid #e0e0e0;
      padding: 5px 6px;
      font-size: 12px;
    }
    .total-box {
      font-size: 13px;
      text-align: right;
    }
    .total-row {
      text-align: right;
      padding: 4px 0;
      border-bottom: 1px solid #ccc;
    }
    .total-row.grand-total {
      border-bottom: 2px solid #333;
      font-weight: bold;
      background-color: #f9f9f9;
      padding: 5px 0;
      margin-top: -1px;
    }
    .footer {
      margin-top: 4px;
      padding-top: 4px;
      border-top: 1px solid #ccc;
      font-size: 11pt;
      text-align: right;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="title">請求書</div>
    </div>

    <!-- メインテーブル構造（48% + 4% + 48%） -->
    <table class="main-table">
      <!-- 基本情報行 -->
      <tr>
        <td colspan="3" style="padding-bottom: 4px;">
          <div class="info-row">
            <span class="info-label">請求書番号</span>
            <span class="info-value"><%= invoice.invoice_number %></span>
          </div>
          <div class="info-row">
            <span class="info-label">発行日</span>
            <span class="info-value"><%= invoice.issue_date.strftime('%Y年%m月%d日') %></span>
          </div>
        </td>
      </tr>

      <!-- 請求先・発行者情報行 -->
      <tr>
        <td class="left-col">
          <div class="box">
            <div class="box-title">請求先</div>
            <% if customer&.company_name.present? %>
              <div style="margin-bottom: 4px; font-size: 14px; font-weight: bold;"><%= customer.company_name %> 御中</div>
            <% else %>
              <div style="margin-bottom: 4px; font-size: 14px;"><%= customer&.name %> 様</div>
            <% end %>
            <% if application.present? %>
              <div style="margin-bottom: 2px; font-size: 13px;">
                <span style="font-weight: bold;">案件：</span><%= application.title %>
              </div>
            <% end %>
          </div>
        </td>
        <td class="spacer-col"></td>
        <td class="right-col">
          <div class="box">
            <div class="box-title">発行者</div>
            <div style="margin-bottom: 4px; font-size: 14px; font-weight: bold;">行政ポータル事務所</div>
            <div style="margin-bottom: 2px; font-size: 13px;">〒100-0000</div>
            <div style="margin-bottom: 5px; font-size: 13px;">東京都千代田区〇〇1-2-3</div>
            <table cellspacing="0" cellpadding="0" style="width: 100%;">
              <tr>
                <td style="width: 40px; font-size: 13px; color: #666; padding: 1px 0; vertical-align: top;">TEL</td>
                <td style="font-size: 13px; padding: 1px 0;">03-1234-5678</td>
              </tr>
              <tr>
                <td style="width: 40px; font-size: 13px; color: #666; padding: 1px 0; vertical-align: top;">FAX</td>
                <td style="font-size: 13px; padding: 1px 0;">03-1234-5679</td>
              </tr>
              <tr>
                <td style="width: 40px; font-size: 13px; color: #666; padding: 1px 0; vertical-align: top;">Email</td>
                <td style="font-size: 13px; padding: 1px 0;">info@gyoseipotal.jp</td>
              </tr>
            </table>
          </div>
        </td>
      </tr>

      <!-- 請求文言と金額行 -->
      <tr>
        <td colspan="3" style="padding-top: 5px; padding-bottom: 4px;">
          <div style="margin-bottom: 4px; font-size: 14px;">下記の通りご請求申し上げます。</div>
          <div style="font-size: 18px; font-weight: bold; margin-bottom: 2px;">
            金額 <span style="font-size: 24px;"><%= number_with_delimiter(invoice.total.to_i) %> 円</span> <span style="font-size: 14px;">(税込)</span>
          </div>
        </td>
      </tr>

      <!-- 明細行 -->
      <tr>
        <td colspan="3" style="padding-top: 5px; padding-bottom: 4px;">
          <div class="section-title">明細</div>
          <table class="table">
            <thead>
              <tr>
                <th style="width: 8%; text-align: center;">No.</th>
                <th style="text-align: left;">項目</th>
                <th style="width: 20%; text-align: right;">金額</th>
              </tr>
            </thead>
            <tbody>
              <% items.each_with_index do |item, index| %>
              <tr style="background-color: <%= index.even? ? '#ffffff' : '#f8f8f8' %>;">
                <td style="text-align: center;"><%= index + 1 %></td>
                <td style="text-align: left;"><%= item.description %></td>
                <td style="text-align: right;"><%= number_with_delimiter(item.amount.to_i) %></td>
              </tr>
              <% end %>
            </tbody>
          </table>
        </td>
      </tr>

      <!-- 合計行 -->
      <tr>
        <td colspan="2"></td>
        <td class="right-col" style="padding-top: 4px; padding-bottom: 4px; text-align: right;">
          <div class="total-box" style="display: inline-block; text-align: right;">
            <div class="total-row">小計　<%= number_with_delimiter(invoice.subtotal.to_i) %> 円</div>
            <div class="total-row">消費税 (<%= invoice.tax_rate %>%)　<%= number_with_delimiter(invoice.tax_amount.to_i) %> 円</div>
            <div class="total-row grand-total">合計金額　<%= number_with_delimiter(invoice.total.to_i) %> 円</div>
          </div>
        </td>
      </tr>

      <!-- 振込先行 -->
      <tr>
        <td colspan="3" style="padding-top: 4px; padding-bottom: 4px;">
          <div>
            <div class="section-title">振込先</div>
            <div class="info-row">
              <span class="info-label">銀行名</span>
              <span class="info-value">〇〇銀行</span>
            </div>
            <div class="info-row">
              <span class="info-label">支店名</span>
              <span class="info-value">〇〇支店</span>
            </div>
            <div class="info-row">
              <span class="info-label">口座種別</span>
              <span class="info-value">普通預金</span>
            </div>
            <div class="info-row">
              <span class="info-label">口座番号</span>
              <span class="info-value">1234567</span>
            </div>
            <div class="info-row">
              <span class="info-label">口座名義</span>
              <span class="info-value">行政ポータル事務所</span>
            </div>
            <div class="info-row">
              <span class="info-label">支払期日</span>
              <span class="info-value"><strong><%= invoice.due_date.strftime('%Y年%m月%d日') %></strong></span>
            </div>
          </div>
        </td>
      </tr>

      <!-- 備考行 -->
      <% if invoice.notes.present? %>
      <tr>
        <td colspan="3" style="padding-top: 4px; padding-bottom: 4px;">
          <div class="section-title">備考</div>
          <div style="padding: 5px; background-color: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 13px; line-height: 1.3; white-space: pre-line;">
            <%= invoice.notes.gsub(/\r\n|\r|\n/, '<br>').html_safe %>
          </div>
        </td>
      </tr>
      <% end %>

      <!-- フッター行 -->
      <tr>
        <td colspan="3" style="padding-top: 4px;">
          <div class="footer">
            発行日: <%= invoice.issue_date.strftime('%Y年%m月%d日') %>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>

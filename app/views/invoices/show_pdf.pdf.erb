<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>請求書</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Noto Sans JP', 'Hiragino Sans', Arial, sans-serif;
      font-size: 12pt;
      color: #333;
      line-height: 1.6;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px;
    }
    .header {
      text-align: center;
      margin-bottom: 40px;
    }
    .title {
      font-size: 28pt;
      font-weight: bold;
      margin-bottom: 30px;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .info-label {
      font-weight: bold;
      width: 150px;
    }
    .info-value {
      flex: 1;
    }
    .section {
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 14pt;
      font-weight: bold;
      border-bottom: 2px solid #333;
      padding-bottom: 5px;
      margin-bottom: 15px;
    }
    .customer-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
    }
    .customer-box {
      flex: 1;
      margin-right: 20px;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .table th {
      background-color: #f0f0f0;
      border: 1px solid #ccc;
      padding: 10px;
      text-align: left;
      font-weight: bold;
    }
    .table td {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: left;
    }
    .table td.number {
      text-align: right;
    }
    .totals {
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
    }
    .totals-box {
      width: 300px;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      padding: 5px 0;
      border-bottom: 1px solid #ccc;
    }
    .total-row.grand-total {
      border-bottom: 2px solid #333;
      font-size: 14pt;
      font-weight: bold;
      padding: 10px 0;
      margin-top: 10px;
    }
    .notes {
      margin-top: 30px;
      padding: 15px;
      background-color: #f9f9f9;
      border-left: 3px solid #333;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ccc;
      font-size: 10pt;
      text-align: right;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="title">請求書</div>
    </div>

    <!-- Basic Info -->
    <div class="section">
      <div class="info-row">
        <span class="info-label">請求書番号</span>
        <span class="info-value"><%= invoice.invoice_number %></span>
      </div>
      <div class="info-row">
        <span class="info-label">発行日</span>
        <span class="info-value"><%= invoice.issue_date.strftime('%Y年%m月%d日') %></span>
      </div>
      <div class="info-row">
        <span class="info-label">支払期日</span>
        <span class="info-value"><%= invoice.due_date.strftime('%Y年%m月%d日') %></span>
      </div>
    </div>

    <!-- Customer Info -->
    <div class="section">
      <div class="section-title">請求先</div>
      <div class="customer-info">
        <div class="customer-box">
          <div class="info-row">
            <span class="info-label">顧客名</span>
            <span class="info-value"><strong><%= invoice.customer&.name %></strong></span>
          </div>
          <% if invoice.application.present? %>
          <div class="info-row">
            <span class="info-label">案件</span>
            <span class="info-value"><%= invoice.application.title %></span>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Invoice Items -->
    <div class="section">
      <div class="section-title">明細</div>
      <table class="table">
        <thead>
          <tr>
            <th>品名</th>
            <th style="width: 120px;" class="number">単価 (円)</th>
            <th style="width: 80px;" class="number">数量</th>
            <th style="width: 120px;" class="number">金額 (円)</th>
          </tr>
        </thead>
        <tbody>
          <% invoice.invoice_items.each do |item| %>
          <tr>
            <td><%= item.description %></td>
            <td class="number"><%= number_with_delimiter(item.unit_price.to_i) %></td>
            <td class="number"><%= item.quantity %></td>
            <td class="number"><%= number_with_delimiter((item.unit_price.to_i * item.quantity.to_i)) %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Totals -->
    <div class="totals">
      <div class="totals-box">
        <div class="total-row">
          <span>小計 (税抜き)</span>
          <span><%= number_with_delimiter(invoice.subtotal.to_i) %> 円</span>
        </div>
        <div class="total-row">
          <span>消費税 (<%= invoice.tax_rate %>%)</span>
          <span><%= number_with_delimiter(invoice.tax_amount.to_i) %> 円</span>
        </div>
        <div class="total-row grand-total">
          <span>合計</span>
          <span><%= number_with_delimiter(invoice.total.to_i) %> 円</span>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <% if invoice.notes.present? %>
    <div class="section">
      <div class="section-title">備考</div>
      <div class="notes">
        <%= simple_format(invoice.notes) %>
      </div>
    </div>
    <% end %>

    <!-- Footer -->
    <div class="footer">
      発行日: <%= invoice.issue_date.strftime('%Y年%m月%d日') %>
    </div>
  </div>
</body>
</html>

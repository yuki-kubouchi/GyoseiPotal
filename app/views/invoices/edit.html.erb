<%# app/views/invoices/edit.html.erb %>
<% content_for :title, "請求書編集" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">請求書編集 <span class="text-lg text-gray-500">#<%= @invoice.invoice_number %></span></h2>
    </div>
    <div class="mt-4 flex md:mt-0 md:ml-4">
      <%= link_to 'キャンセル', invoice_path(@invoice), class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
    </div>
  </div>

  <div class="mt-8">
    <%= render 'form', invoice: @invoice %>
  </div>
</div>
<div class="nested-fields mb-4 p-4 border border-gray-200 rounded-md bg-gray-50">
  <div class="grid grid-cols-12 gap-4">
    <div class="col-span-12 sm:col-span-6">
      <%= f.label :description, '品名', class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :description, class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>
    <div class="col-span-12 sm:col-span-4 flex flex-col">
      <%= f.label :unit_price, '単価', class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1 flex gap-2">
        <div class="relative flex-1 rounded-md shadow-sm">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-gray-500 sm:text-sm">¥</span>
          </div>
          <%= f.number_field :unit_price, step: '1000', class: "focus:ring-blue-500 focus:border-blue-500 block w-full pl-7 pr-10 sm:text-sm border-gray-300 rounded-md unit-price-field" %>
        </div>
        <div class="flex gap-1">
          <button type="button" class="price-btn-down px-2 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" title="1000円減">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
            </svg>
          </button>
          <button type="button" class="price-btn-up px-2 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" title="1000円増">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div class="col-span-12 sm:col-span-2 flex flex-col hidden">
      <label class="block text-sm font-medium text-gray-700">金額</label>
      <div class="mt-1 relative rounded-md shadow-sm flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 sm:text-sm">¥</span>
        </div>
        <input type="text" readonly class="bg-gray-100 block w-full pl-7 pr-10 sm:text-sm border-gray-300 rounded-md amount-field" value="<%= number_with_precision(f.object.amount, precision: 0, delimiter: ',') %>">
      </div>
    </div>
    <div class="col-span-12 sm:col-span-1 flex items-end justify-end">
      <%= link_to_remove_association f, class: 'text-red-600 hover:text-red-800 px-2 py-2', data: { confirm: 'この明細を削除しますか？' } do %>
        <span class="sr-only">削除</span>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      <% end %>
    </div>
  </div>
  <%= f.hidden_field :_destroy, class: 'destroy-field' %>
  <%= f.hidden_field :quantity, value: 1 %>
</div>


<% content_for :title, "請求一覧" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">請求一覧</h1>
    <div class="flex items-center gap-2">
      <%= link_to "CSVエクスポート", invoices_path(request.query_parameters.merge(format: :csv, page: nil)), class: "inline-flex items-center rounded-lg px-3 py-2 bg-gray-100 hover:bg-gray-50 text-gray-800" %>
      <%= link_to "新規請求", new_invoice_path, class: "inline-flex items-center rounded-lg px-4 py-2 bg-primary-blue text-white hover:bg-blue-700 transition shadow" %>
    </div>
  </div>

  <%= form_with url: invoices_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-6 gap-3 mb-6" do %>
    <div>
      <label class="block text-sm text-gray-600">検索（請求書番号/顧客/案件）</label>
      <input type="text" name="q" value="<%= @q %>" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="例: INV-20231126-XXXX" />
    </div>
    <div>
      <label class="block text-sm text-gray-600">ステータス</label>
      <select name="status" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">すべて</option>
        <% Invoice.statuses.keys.each do |k| %>
          <% label = {"draft"=>"下書き","sent"=>"送付済み","paid"=>"入金済み","overdue"=>"期限切れ","cancelled"=>"キャンセル"}[k] %>
          <option value="<%= k %>" <%= "selected" if @status==k %>><%= label %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-sm text-gray-600">顧客</label>
      <select name="customer_id" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
        <option value="">すべて</option>
        <% Customer.order(:name).each do |c| %>
          <option value="<%= c.id %>" <%= "selected" if @customer_id==c.id.to_s %>><%= c.name %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-sm text-gray-600">発行日（開始）</label>
      <input type="date" name="start_date" value="<%= @start_date&.strftime('%Y-%m-%d') %>" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm text-gray-600">発行日（終了）</label>
      <input type="date" name="end_date" value="<%= @end_date&.strftime('%Y-%m-%d') %>" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
    </div>
    <div class="flex items-end">
      <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">検索</button>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">請求書番号</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">顧客名</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">案件名</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金額</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">発行日</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">支払期日</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">ステータス</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-32">アクション</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @invoices.each do |invoice| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= invoice.invoice_number %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= invoice.customer.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= invoice.application&.title %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-right"><%= number_with_delimiter(invoice.total.to_i) %> 円</td>
            <td class="px-4 py-3 text-gray-900 whitespace-nowrap"><%= invoice.issue_date&.strftime('%Y/%m/%d') %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= invoice.due_date&.strftime('%Y/%m/%d') %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if invoice.status.present? %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_badge_class(invoice.status) %>">
                  <%= t("enums.invoice.status.#{invoice.status}", default: invoice.status) %>
                </span>
              <% else %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                  未設定
                </span>
              <% end %>
            </td>
            <td class="px-2 py-4 whitespace-nowrap text-sm font-medium w-32">
              <div class="flex justify-center space-x-2">
                <%= link_to invoice_path(invoice), class: 'inline-flex items-center justify-center p-2 rounded-lg text-blue-600 hover:bg-blue-50 hover:text-blue-900 transition', title: '詳細[印刷画面]' do %>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                <% end %>
                <%= link_to edit_invoice_path(invoice), class: 'inline-flex items-center justify-center p-2 rounded-lg text-indigo-600 hover:bg-indigo-50 hover:text-indigo-900 transition', title: '編集' do %>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
                <%= link_to invoice_path(invoice), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'inline-flex items-center justify-center p-2 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-900 transition', title: '削除' do %>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%= paginate @invoices, views_prefix: nil %>
  </div>
</div>
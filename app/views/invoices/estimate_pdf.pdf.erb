<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>見積書</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 14px; margin: 20px; }
    .debug { background: yellow; border: 3px solid red; padding: 20px; margin-bottom: 30px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    th, td { border: 1px solid #333; padding: 8px; text-align: left; }
    th { background-color: #f0f0f0; }
    h1, h2 { margin-top: 20px; }
  </style>
</head>
<body>
  
  <div class="debug">
    <h2>DEBUG TEST</h2>
    <p>Hard-coded: 吉田建設株式会社</p>
    <p>Ruby string: <%= "吉田建設株式会社" %></p>
    <p>HTML Entity: &#21513;&#30000;&#24314;&#35373;&#26666;&#24335;&#20250;&#31038;</p>
    <p>Numbers: 123456789</p>
    <p>English: Hello World</p>
    <hr>
    <p>Customer Name (AR): <%= @invoice.customer.name.to_s %></p>
    <p>Company Name (AR): <%= @invoice.customer.company_name.to_s %></p>
    <p>Application (AR): <%= @invoice.application.title.to_s %></p>
  </div>

  <h1>見積書</h1>
  
  <table>
    <tr>
      <td style="width: 30%;">見積番号</td>
      <td><%= @invoice.invoice_number %></td>
    </tr>
    <tr>
      <td>発行日</td>
      <td><%= @invoice.issue_date.strftime('%Y年%m月%d日') %></td>
    </tr>
    <tr>
      <td>顧客名</td>
      <td><%= @invoice.customer.company_name.to_s.presence || @invoice.customer.name.to_s %></td>
    </tr>
    <tr>
      <td>案件名</td>
      <td><%= @invoice.application.title.to_s %></td>
    </tr>
  </table>

  <h2>明細</h2>
  <table>
    <thead>
      <tr>
        <th>品目</th>
        <th style="width: 10%;">数量</th>
        <th style="width: 20%;">単価</th>
        <th style="width: 20%;">金額</th>
      </tr>
    </thead>
    <tbody>
      <% @invoice.invoice_items.each do |item| %>
        <tr>
          <td><%= item.description.to_s %></td>
          <td style="text-align: right;"><%= item.quantity %></td>
          <td style="text-align: right;"><%= number_with_delimiter(item.unit_price.to_i) %> 円</td>
          <td style="text-align: right;"><%= number_with_delimiter(item.amount.to_i) %> 円</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2>合計金額</h2>
  <table style="width: 50%; margin-left: auto;">
    <tr>
      <td>小計（税抜）</td>
      <td style="text-align: right;"><%= number_with_delimiter(@invoice.subtotal.to_i) %> 円</td>
    </tr>
    <tr>
      <td>消費税（10%）</td>
      <td style="text-align: right;"><%= number_with_delimiter(@invoice.tax_amount.to_i) %> 円</td>
    </tr>
    <tr style="font-weight: bold; font-size: 16px;">
      <td>合計（税込）</td>
      <td style="text-align: right;"><%= number_with_delimiter(@invoice.total.to_i) %> 円</td>
    </tr>
  </table>

</body>
</html>

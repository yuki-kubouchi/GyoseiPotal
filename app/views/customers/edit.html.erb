<% content_for :title, "顧客編集" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">顧客編集</h1>

  <%= render "form", customer: @customer %>

  <%= link_to "顧客詳細を表示", @customer, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "顧客一覧に戻る", customers_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>

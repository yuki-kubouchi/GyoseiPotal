<!DOCTYPE html>
<html>
  <head>
    <title>GyoseiPotal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", data: { turbo_track: "reload" } %>
    <%= stylesheet_link_tag "application", data: { turbo_track: "reload" } %>
    <script src="https://unpkg.com/@kurkle/color@0.4.5/dist/color.umd.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags "application" %>
    <%= javascript_include_tag "https://www.gstatic.com/charts/loader.js", data: { turbo_track: "reload" } %>
    <%= javascript_import_module_tag "chartkick" %>
    <script>
      // Turbo のページ遷移後にグラフを再初期化
      document.addEventListener('turbo:load', function() {
        // Chart.js のグラフを再初期化
        if (typeof Chart !== 'undefined') {
          // 既存のグラフインスタンスを破棄
          Chart.helpers.each(Chart.instances, function(instance) {
            instance.destroy();
          });
          
          // 新しいグラフを初期化
          if (typeof initCharts === 'function') {
            initCharts();
          }
        }
      });
    </script>
  </head>

  <body class="min-h-screen flex">
    <!-- Mobile header with hamburger menu -->
    <header class="md:hidden fixed top-0 left-0 right-0 bg-white shadow-md z-30 p-4 flex justify-between items-center">
      <button onclick="toggleSidebar()" class="text-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
      <h1 class="text-lg font-semibold">行政書士 Portal</h1>
      <div class="w-6"></div>
    </header>

    <!-- message box -->
    <div id="message-box" class="fixed top-5 right-5 hidden bg-white border border-primary-blue text-primary-blue px-6 py-3 rounded-lg shadow-xl z-50 transition transform duration-300">
      <div class="flex items-center justify-between">
        <span id="message-text"></span>
        <button onclick="closeMessageBox()" class="ml-4 text-primary-blue hover:text-gray-700">
          <svg class="icon" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>

    <!-- overlay (mobile) -->
    <div id="overlay" class="fixed inset-0 bg-black opacity-50 z-10 md:hidden hidden" onclick="toggleSidebar()"></div>

    <!-- sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 transform -translate-x-full md:translate-x-0 w-64 bg-primary-blue text-white shadow-xl transition-transform duration-300 ease-in-out z-20 md:relative flex flex-col">
      <div class="p-6 border-b border-blue-800 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-extrabold tracking-wider">行政書士 Portal</h1>
          <p class="text-sm opacity-75 mt-1">申請・日程管理</p>
        </div>
        <button onclick="toggleSidebar()" class="md:hidden text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav class="flex-grow p-4 space-y-2 custom-scrollbar overflow-y-auto">
        <a href="<%= root_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <span>ダッシュボード</span>
        </a>
        <a href="<%= applications_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
          <span>申請一覧</span>
        </a>
        <a href="<%= schedules_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>スケジュール</span>
        </a>
        <a href="<%= customers_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>顧客情報</span>
        </a>
        <a href="<%= invoices_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
          <span>請求一覧</span>
        </a>
        <a href="<%= analysis_path %>" class="flex items-center p-3 rounded-xl hover:bg-blue-700/50 transition duration-150" onclick="if(window.innerWidth < 768) toggleSidebar()">
          <svg class="icon mr-3" viewBox="0 0 24 24"><path d="M12 20V10"></path><path d="M18 20V4"></path><path d="M6 20v-4"></path></svg>
          <span>データ分析</span>
        </a>
        <div class="h-px bg-blue-700 my-4"></div>
        <div class="mt-auto pt-4 border-t border-blue-800">
          <div class="px-3 py-2 text-sm text-blue-200">
            管理者としてログイン中
          </div>
        </div>
      </nav>
      <div class="p-4 border-t border-blue-800">
        <p class="text-sm opacity-75"> 2025 Gyoseishoshi App</p>
      </div>
    </aside>

    <!-- main content area -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto custom-scrollbar mt-16 md:mt-0">
      <%= yield %>
    </main>

    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        
        // サイドバーの表示/非表示を切り替え
        sidebar.classList.toggle('-translate-x-full');
        // オーバーレイの表示/非表示を切り替え
        overlay.classList.toggle('hidden');
        // スクロールのロック/アンロック
        document.body.style.overflow = overlay.classList.contains('hidden') ? 'auto' : 'hidden';
      }

      // オーバーレイのクリックイベント
      document.getElementById('overlay').addEventListener('click', function(e) {
        e.stopPropagation();
        toggleSidebar();
      });

      // リサイズイベントでサイドバーの状態を調整
      function handleResize() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        
        if (window.innerWidth >= 768) {
          // デスクトップ表示の場合はサイドバーを表示
          sidebar.classList.remove('-translate-x-full');
          overlay.classList.add('hidden');
          document.body.style.overflow = 'auto';
        } else {
          // モバイル表示の場合はサイドバーを非表示
          sidebar.classList.add('-translate-x-full');
        }
      }

      // 初期化
      document.addEventListener('DOMContentLoaded', () => {
        handleResize();
        window.addEventListener('resize', handleResize);
        
        // モバイルでメニュー項目をクリックしたらサイドバーを閉じる
        document.querySelectorAll('#sidebar a').forEach(link => {
          link.addEventListener('click', () => {
            if (window.innerWidth < 768) {
              toggleSidebar();
            }
          });
        });
      });

      // メッセージボックス関連の関数
      function viewApplication(id) {
        const messageBox = document.getElementById('message-box');
        const messageText = document.getElementById('message-text');
        messageText.textContent = `ID: ${id} `;
        messageBox.classList.remove('hidden');
        setTimeout(() => { messageBox.classList.add('hidden'); }, 3000);
      }

      function closeMessageBox() { 
        document.getElementById('message-box').classList.add('hidden'); 
      }
    </script>
  </body>
</html>
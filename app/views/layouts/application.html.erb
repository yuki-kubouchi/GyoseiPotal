<!DOCTYPE html>
<html>
  <head>
    <title>GyoseiPotal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <%# JavaScriptの読み込み %>
    <%= javascript_importmap_tags %>
    <script type="module">
      import "application";
      
      // Turbo のページ遷移後にグラフを再初期化
      document.addEventListener('turbo:load', function() {
        // Chart.js のグラフを再初期化
        if (typeof Chart !== 'undefined') {
          // 既存のグラフインスタンスを破棄
          Chart.helpers.each(Chart.instances, function(instance) {
            instance.destroy();
          });
          
          // 新しいグラフを初期化
          if (typeof initCharts === 'function') {
            initCharts();
          }
        }
      });
    </script>
  </head>

  <body class="min-h-screen bg-gray-100">
    <!-- Mobile header with hamburger menu -->
    <header class="md:hidden fixed top-0 left-0 right-0 bg-white shadow-md z-30 p-4 flex justify-between items-center">
      <button onclick="toggleSidebar()" class="text-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
      <h1 class="text-lg font-semibold">行政書士 Portal</h1>
      <div class="w-6"></div>
    </header>

    <!-- message box -->
    <div id="message-box" class="fixed top-5 right-5 hidden bg-white border border-primary-blue text-primary-blue px-6 py-3 rounded-lg shadow-xl z-50 transition transform duration-300">
      <div class="flex items-center justify-between">
        <span id="message-text"></span>
        <button onclick="closeMessageBox()" class="ml-4 text-primary-blue hover:text-gray-700">
          <svg class="icon" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>

    <!-- overlay (mobile) -->
    <div id="overlay" class="fixed inset-0 bg-black opacity-50 z-10 md:hidden hidden" onclick="toggleSidebar()"></div>

    <!-- sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-blue-800 text-white shadow-lg z-20 transform transition-transform duration-300 md:translate-x-0 -translate-x-full md:block">
      <div class="sidebar-header">
        <h1 class="text-xl font-bold">行政書士 Portal</h1>
        <p class="text-sm opacity-75">申請・日程管理</p>
        <button onclick="toggleSidebar()" class="md:hidden absolute top-4 right-4 text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav>
        <a href="<%= root_path %>" class="<%= 'active' if current_page?(root_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <span>ダッシュボード</span>
        </a>
        <a href="<%= applications_path %>" class="<%= 'active' if current_page?(applications_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
          <span>申請一覧</span>
        </a>
        <a href="<%= schedules_path %>" class="<%= 'active' if current_page?(schedules_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>スケジュール</span>
        </a>
        <a href="<%= customers_path %>" class="<%= 'active' if current_page?(customers_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>顧客情報</span>
        </a>
        <a href="<%= invoices_path %>" class="<%= 'active' if current_page?(invoices_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
          <span>請求一覧</span>
        </a>
        <a href="<%= analysis_path %>" class="<%= 'active' if current_page?(analysis_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"></path><path d="M18 20V4"></path><path d="M6 20v-4"></path></svg>
          <span>データ分析</span>
        </a>
        <div class="h-px bg-blue-700 my-4"></div>
        <a href="<%= edit_office_setting_path %>" class="<%= 'active' if current_page?(edit_office_setting_path) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span>事務所情報</span>
        </a>
        <div class="mt-auto pt-4 border-t border-blue-800">
          <div class="px-3 py-2 text-sm text-blue-100">
            管理者としてログイン中
          </div>
        </div>
      </nav>
      <div class="p-4 border-t border-blue-700">
        <p class="text-sm text-blue-100">2025 Gyoseishoshi App</p>
      </div>
    </aside>

    <!-- main content area -->
    <div class="md:ml-64 pt-16 md:pt-0 p-4 md:p-8">
      <main class="bg-white rounded-lg shadow p-4 md:p-6">
        <%= yield %>
      </main>
    </div>

    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');
      }

      function closeMessageBox() {
        document.getElementById('message-box').classList.add('hidden');
      }

      // メッセージ表示関数
      function showMessage(message, type = 'info') {
        const messageBox = document.getElementById('message-box');
        const messageText = document.getElementById('message-text');
        
        messageText.textContent = message;
        messageBox.className = `fixed top-5 right-5 flex items-center ${type === 'error' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'} px-6 py-3 rounded-lg shadow-xl z-50 transition transform duration-300`;
        messageBox.classList.remove('hidden', 'opacity-0', 'translate-y-4');
        
        // 5秒後にメッセージを非表示にする
        setTimeout(() => {
          messageBox.classList.add('opacity-0', 'translate-y-4');
          setTimeout(() => {
            messageBox.classList.add('hidden');
          }, 300);
        }, 5000);
      }

      // フラッシュメッセージがある場合は表示
      document.addEventListener('DOMContentLoaded', function() {
        <% if flash[:notice] %>
          showMessage('<%= j flash[:notice] %>', 'info');
        <% elsif flash[:alert] %>
          showMessage('<%= j flash[:alert] %>', 'error');
        <% end %>
      });

      // ウィンドウリサイズ時の処理
      window.addEventListener('resize', function() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        
        if (window.innerWidth >= 768) {
          overlay.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });
    </script>
  </body>
</html>
<% content_for :title, "事務所情報設定" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">事務所情報設定</h1>
    <p class="mt-1 text-sm text-gray-600">PDFや帳票に表示される事務所情報を設定します。</p>
  </div>

  <%= form_with(model: @office_setting, url: office_setting_path, method: :patch, local: true, class: "space-y-6") do |form| %>
    <% if @office_setting.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">エラーが発生しました</h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @office_setting.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 基本情報セクション -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">基本情報</h2>
        <p class="mt-1 text-sm text-gray-500">事務所の基本情報を入力してください。</p>
      </div>
      <div class="px-6 py-5 space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            事務所名 <span class="text-red-500">*</span>
          </label>
          <%= form.text_field :name, 
              class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              placeholder: "例: くぼうち行政書士事務所" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">郵便番号</label>
            <%= form.text_field :postal_code,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 123-4567" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">住所</label>
          <%= form.text_area :address,
              rows: 2,
              class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              placeholder: "例: 東京都千代田区〇〇1-2-3" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">電話番号</label>
            <%= form.text_field :phone,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 03-1234-5678" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">FAX番号</label>
            <%= form.text_field :fax,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 03-1234-5679" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">メールアドレス</label>
            <%= form.email_field :email,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: info@example.com" %>
          </div>
        </div>
      </div>
    </div>

    <!-- 銀行口座情報セクション -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">銀行口座情報</h2>
        <p class="mt-1 text-sm text-gray-500">請求書に記載する振込先情報を入力してください。</p>
      </div>
      <div class="px-6 py-5 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">銀行名</label>
            <%= form.text_field :bank_name,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 〇〇銀行" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">支店名</label>
            <%= form.text_field :branch_name,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 〇〇支店" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">口座種別</label>
            <%= form.select :account_type,
                options_for_select([['普通預金', '普通預金'], ['当座預金', '当座預金']], @office_setting.account_type),
                { include_blank: '選択してください' },
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">口座番号</label>
            <%= form.text_field :account_number,
                class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "例: 1234567" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">口座名義</label>
          <%= form.text_field :account_holder,
              class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              placeholder: "例: クボウチギョウセイショシジムショ" %>
        </div>
      </div>
    </div>

    <!-- アクションボタン -->
    <div class="flex items-center justify-end space-x-4">
      <%= link_to "キャンセル", root_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= form.submit "保存", class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow" %>
    </div>
  <% end %>
</div>
